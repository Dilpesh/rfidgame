 {
  "id": "BOBO_BIRTHDAY_S01_001_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Hey! Hi, Captain! मैं हूँ Coco और आज मेरे friend Bobo का birthday है। क्या तुम Bobo की birthday party arrange करने में मेरी help करोगे?",
  "emotion": "upbeat, welcoming",
  "scene": 1,
  "library": false,
  "nameText": "Hey! Hi, {name}! मैं हूँ Coco और आज मेरे friend Bobo का birthday है। क्या तुम Bobo की birthday party arrange करने में मेरी help करोगे?",
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S01_002_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Great! तो चलो सबसे पहले party की सबसे yummy चीज़ ढूँढते हैं…",
  "emotion": "bright",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S01_003_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "कुछ ऐसा जो मीठा होता है, soft होता है, और birthday पर cut किया जाता है! उसका card ढूँढो और please tap करो!",
  "emotion": "playful, riddling",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S01_004_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "नहीं मिला? अरे, हम बात कर रहे हैं Cake की! जल्दी से Cake Card को tap करो!",
  "emotion": "bright, revealing",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S01_005_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Cake वाला card ढूँढो — गोल cake, ऊपर cream वाला।",
  "emotion": "kind",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S01_006_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Cake वाला card tap करो!",
  "emotion": "kind, clear",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "lib:magic_sparkle",
  "kind": "sfx",
  "name": "magic_sparkle",
  "scene": 1,
  "library": true,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_007_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "YES! Cake! एक sweet, sweet birthday cake!",
  "emotion": "excited",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_008_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "पर पता है Captain?",
  "emotion": "leaning in",
  "scene": 2,
  "library": false,
  "nameText": "पर पता है {name}?",
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_009_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अगर Bobo और हम सिर्फ cake खाएँगे, तो tummy ache हो सकता है। Party में non-stop मस्ती और dance करने के लिए हमें super energy चाहिए!",
  "emotion": "explaining, playful",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_010_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "क्या तुम cards में से कोई ऐसा healthy food ढूँढ सकते हो जो हमें strong बनाए और super-energy दे?",
  "emotion": "inviting",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_011_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ध्यान से देखो… yummy, healthy banana! Fast-fast Banana Card को tap करो और healthy power लो!",
  "emotion": "bright, revealing",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_012_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Banana वाला card — पीला, लंबा केला।",
  "emotion": "kind",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_013_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Banana वाला card tap करो!",
  "emotion": "kind, clear",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "lib:biscuit_crunch",
  "kind": "sfx",
  "name": "biscuit_crunch",
  "scene": 2,
  "library": true,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S02_014_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Yum! Yummy banana! अब आई ना असली birthday energy!",
  "emotion": "excited",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_015_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अब हमारा cake ready है! लेकिन birthday cake के ऊपर हम क्या लगाते हैं जिसे फूँक मारकर blow करते हैं?",
  "emotion": "curious, leading",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_016_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Candle! जल्दी से Candle Card को tap करो!",
  "emotion": "bright, revealing",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_017_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Candle वाला card — जलती हुई candle वाला।",
  "emotion": "kind",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_018_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Candle वाला card tap करो!",
  "emotion": "kind, clear",
  "scene": 3,
  "library": false,
  "missing": false
 },
