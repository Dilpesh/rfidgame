 {
  "id": "BOBO_BIRTHDAY_S04_003_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "वाह, party लगभग ready है! पर party में और क्या चाहिए, जिससे सब dance करें? धन-टना-टन… Music!",
  "emotion": "listing, building up",
  "scene": 4,
  "library": false,
  "auto": true,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S04_030_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "जिससे loud आवाज़ में birthday music बजता है… वो कौनसा card है?",
  "emotion": "playful, riddling",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S04_031_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "जल्दी से Speaker Card को tap करो!",
  "emotion": "bright, revealing",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S04_032_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Speaker वाला card — जिससे music बजता है।",
