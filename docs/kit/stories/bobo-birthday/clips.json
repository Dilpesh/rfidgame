 {
  "id": "BOBO_BIRTHDAY_S03_023_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अरे! इतनी ज़ोर की फूँक… मेरी cap उड़ गई! Woooosh!",
  "emotion": "surprised, laughing",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_002_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "देखो, table पर एक real Birthday Cap रखी है! उसे उठाओ और सर पर पहन लो!",
  "emotion": "warm, slow",
  "scene": 3,
  "library": false,
  "auto": true,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_025_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अब जल्दी से table पर रखे Birthday Cap Card को भी tap कर दो!",
  "emotion": "bright",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_026_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "आराम से पहनो। Cap पहन कर, Cap वाला card tap करना।",
  "emotion": "relaxed, reassuring",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
