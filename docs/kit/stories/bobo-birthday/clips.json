  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_019_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Yes! Candle!",
  "emotion": "excited",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "BOBO_BIRTHDAY_S03_001_COCO",
  "kind": "speech",
  "speaker": "COCO",
  "text": "चलो, Bobo के साथ candles बुझाते हैं — ज़ोर से फूँक मारो!",
  "emotion": "excited, inviting",
  "scene": 3,
  "library": false,
