  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_109",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अरे! यह तो Lion King की आवाज़ है! आप rock के पीछे क्या कर रहे हैं?",
  "emotion": "surprised",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_110",
  "kind": "speech",
  "speaker": "LION",
  "text": "कोको... मैं यहाँ रास्ता भूल गया हूँ। और यहाँ इतना अंधेरा है कि मुझे अपनी पूँछ भी दिखाई नहीं दे रही!",
  "emotion": "worried but gentle",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_111b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "फ़िक्र मत करो, Lion King! मैं आपका हाथ पकड़ता हूँ… ये लो!",
  "emotion": "confident, reaching out in the dark",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_112b",
  "kind": "speech",
  "speaker": "LION",
  "text": "आऊच! वो मेरा हाथ नहीं — मेरी पूँछ है!",
  "emotion": "surprised yelp, funny not scared",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_113b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ओह! अंधेरे में हाथ और पूँछ एक जैसे लगते हैं!",
  "emotion": "embarrassed laugh",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_115",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अरे! इतना अंधेरा है कि मेरी नाक भी नहीं दिख रही! Captain, हमें तुरंत रोशनी चाहिए, वरना हम सब टकरा जाएँगे!",
  "emotion": "rubbing head, urgent but playful",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_116",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अपने cards में देखो... कोई ऐसी चीज़ है जो अंधेरे में तेज़ रोशनी दे सके?",
  "emotion": "clear and warm",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_117",
  "kind": "speech",
  "speaker": "COCO",
  "text": "इसे ON करते ही अंधेरे में रास्ता साफ़ दिखने लगता है।",
  "emotion": "clear and warm",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_118b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "टॉर्च वाला card scan करो!",
  "emotion": "clear and warm",
  "scene": 6,
  "library": false,
  "missing": false
 },
