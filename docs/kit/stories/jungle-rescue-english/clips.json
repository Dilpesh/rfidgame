 {
  "id": "JR_002",
  "kind": "speech",
  "speaker": "COCO",
  "text": "हैलो, मैं हूँ कोको। आज हम जंगल बचाओ टीम बनेंगे।",
  "emotion": "bright and playful",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_003b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Hello Captain! जंगल में हमारे कई दोस्त मुसीबत में हैं और हमें उन्हें बचाना है। क्या तुम मेरी मदद के लिए तैयार हो?",
  "emotion": "hopeful and inviting",
  "scene": 1,
  "library": false,
  "nameText": "Hello {name}! जंगल में हमारे कई दोस्त मुसीबत में हैं और हमें उन्हें बचाना है। क्या तुम मेरी मदद के लिए तैयार हो?",
  "missing": false
 },
 {
  "id": "JR_004",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Yes! Great! अब Captain और कोको मिलकर सारे animals को बचा लेंगे।",
  "emotion": "delighted and encouraging",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "lib:title_captain",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अब से तुम हो — मेरे Captain!",
  "emotion": "proud, warm",
  "scene": 1,
  "library": true,
  "nameText": "अब से तुम हो — Captain {name}!",
  "missing": false
 },
 {
  "id": "JR_005",
  "kind": "speech",
  "speaker": "COCO",
  "text": "जल्दी चलो, हमारी जंगल रेस्क्यू जीप तैयार है।",
  "emotion": "warm storytelling",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_006",
  "kind": "sfx",
  "name": "jeep_door",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_007",
  "kind": "speech",
  "speaker": "NARRATOR",
  "text": "कोको जीप में बैठा, स्टीयरिंग पकड़ी, चाबी घुमाई।",
  "emotion": "warm and brisk",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_008",
  "kind": "sfx",
  "name": "key_turn_engine_cough",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_009b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ओह, ये स्टार्ट क्यों नहीं हो रही? हम्म… Jeep का पेट खाली है! गाड़ी को पेट्रोल पीना पड़ता है — जैसे बच्चों को दूध।",
  "emotion": "surprised, then explaining warmly",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_010b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, अपने cards में पेट्रोल ढूँढो — Jeep को पिलाना है!",
  "emotion": "inviting, clear",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_011b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Jeep भूखी है… cards में पेट्रोल दिख रहा है?",
  "emotion": "kind and clear",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_012b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "लाल रंग का पेट्रोल pump — जिसमें एक pipe लगा है।",
  "emotion": "kind and clear",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_013b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "पेट्रोल वाला card scan करो — लाल pump वाला।",
  "emotion": "kind and clear",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_014",
  "kind": "sfx",
  "name": "ting",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_015b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "YES! पेट्रोल! Jeep का पेट भर गया!",
  "emotion": "excited",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_016",
  "kind": "sfx",
  "name": "fuel_pour",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_017",
  "kind": "sfx",
  "name": "engine_start",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_018",
  "kind": "speech",
  "speaker": "COCO",
  "text": "जंगल रेस्क्यू टीम चलो!",
  "emotion": "energetic rallying call",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_019",
  "kind": "sfx",
  "name": "overflow_bloop",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_020b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ओहो! बस करो, Captain! पेट्रोल छलक जाएगा!",
  "emotion": "comic surprise and affection",
  "scene": 1,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_021",
  "kind": "bed",
  "name": null,
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_022",
  "kind": "speech",
  "speaker": "NARRATOR",
  "text": "जीप जंगल के अंदर गई। बड़े-बड़े पेड़, छोटी-छोटी नदियाँ, उछलती-कूदती जीप!",
  "emotion": "bouncy and curious",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_023",
  "kind": "sfx",
  "name": "jeep_bump",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_024",
  "kind": "sfx",
  "name": "jeep_bump",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_025",
  "kind": "sfx",
  "name": "jeep_bump",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_026",
  "kind": "speech",
  "speaker": "COCO",
  "text": "वो! ये रोड है या ट्रैम्पोलीन?",
  "emotion": "surprised and comic",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_027",
  "kind": "sfx",
  "name": "elephant_trumpet",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "lib:look",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, देखो!",
  "emotion": "urgent, excited",
  "scene": 2,
  "library": true,
  "nameText": "{name}, देखो!",
  "missing": false
 },
 {
  "id": "JR_028",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अरे! एलिफेंट दादा एक बड़े मड्डी गड्ढे में फँसे हैं। चिंता मत करो, कोको सुपर रेस्क्यू आ गया!",
  "emotion": "concerned and reassuring",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_029",
  "kind": "speech",
  "speaker": "NARRATOR",
  "text": "कोको ने एलिफेंट दादा को खींचा।",
  "emotion": "brisk and physical",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_030",
  "kind": "speech",
  "speaker": "COCO",
  "text": "एक, दो, तीन!",
  "emotion": "effortful and rhythmic",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_031",
  "kind": "sfx",
  "name": "pull_strain",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_032",
  "kind": "sfx",
  "name": "mud_splat",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_033",
  "kind": "speech",
  "speaker": "NARRATOR",
  "text": "और कोको खुद मड में गिर गया!",
  "emotion": "comic surprise",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_034",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ये कौन करता है?!",
  "emotion": "funny signature voice",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_035",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ओके, नया प्लान चाहिए.",
  "emotion": "small embarrassed laugh, recovering quickly",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_036",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, हमें कोई लंबी चीज़ चाहिए जिससे एलिफेंट दादा को अपनी तरफ खींच सकें। क्या हमारे पास ऐसी कोई चीज़ है?",
  "emotion": "clear and warm",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_037",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अपने cards को देखो... कोई लंबी चीज़ दिख रही है जिससे हम खींच सकें?",
  "emotion": "clear and warm",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_038",
  "kind": "speech",
  "speaker": "COCO",
  "text": "इसे पकड़कर किसी चीज़ को अपनी तरफ खींचा जा सकता है.",
  "emotion": "clear and warm",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_039b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "रस्सी वाला card scan करो.",
  "emotion": "clear and warm",
  "scene": 2,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_040",
  "kind": "sfx",
  "name": "ting",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_041b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "YES! रस्सी मिल गई! अब एलिफेंट दादा को बाहर निकालने में कोको की मदद करो।",
  "emotion": "bright and encouraging",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_042",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, बैठे-बैठे रस्सी खींचने का नाटक करो। Pull!",
  "emotion": "playful and encouraging",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_043",
  "kind": "sfx",
  "name": "rope_creak",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_044",
  "kind": "speech",
  "speaker": "COCO",
  "text": "फिर से। Pull!",
  "emotion": "clear and warm",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_045",
  "kind": "sfx",
  "name": "rope_creak",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_046",
  "kind": "speech",
  "speaker": "COCO",
  "text": "एक आखिरी बार। Pull, pull… अरे, pull-pull करते-करते दिमाग़ की बत्ती गुल हो गई!",
  "emotion": "comically breathless",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_047",
  "kind": "sfx",
  "name": "mud_pop_release",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_048",
  "kind": "speech",
  "speaker": "COCO",
  "text": "यस, एलिफेंट दादा बाहर आ गए.",
  "emotion": "relieved and happy",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_049",
  "kind": "speech",
  "speaker": "COCO",
  "text": "वाह Captain! तुमने कितना ज़ोर लगाया!",
  "emotion": "proud and impressed",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_050",
  "kind": "speech",
  "speaker": "ELEPHANT",
  "text": "Thank you, Captain!",
  "emotion": "relieved and grateful",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_051",
  "kind": "sfx",
  "name": "stomach_growl",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_052",
  "kind": "speech",
  "speaker": "COCO",
  "text": "ये क्या था?",
  "emotion": "curious surprise",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_053",
  "kind": "speech",
  "speaker": "ELEPHANT",
  "text": "मेरे पेट में भूख से चूहे दौड़ रहे हैं।",
  "emotion": "playfully hungry",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_054",
  "kind": "speech",
  "speaker": "COCO",
  "text": "सिर्फ़ दौड़ नहीं रहे हैं... कूद भी रहे हैं!",
  "emotion": "playful",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_055",
  "kind": "speech",
  "speaker": "COCO",
  "text": "एलिफेंट दादा को भूख लगी है! Captain, क्या हमारे पास कुछ खाने के लिए है?",
  "emotion": "warm and inviting",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_056",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अपने cards में खाने वाली चीज़ ढूँढो।",
  "emotion": "clear and warm",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_057",
  "kind": "speech",
  "speaker": "COCO",
  "text": "कुछ खाने वाला card?",
  "emotion": "clear and warm",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_058",
  "kind": "speech",
  "speaker": "COCO",
  "text": "BISCUIT वाला card tap करो।",
  "emotion": "clear and warm",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_059",
  "kind": "sfx",
  "name": "ting",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_060",
  "kind": "speech",
  "speaker": "COCO",
  "text": "YES! BISCUIT!",
  "emotion": "bright",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_061",
  "kind": "sfx",
  "name": "gulp",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_062",
  "kind": "speech",
  "speaker": "ELEPHANT",
  "text": "बस एक biscuit?",
  "emotion": "surprised",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_067",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, वही BISCUIT वाला card फिर से tap करो।",
  "emotion": "gentle and clear",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_068",
  "kind": "speech",
  "speaker": "COCO",
  "text": "BISCUIT वाला card हटाओ, फिर दोबारा tap करो।",
  "emotion": "helpful and unhurried",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_069",
  "kind": "speech",
  "speaker": "COCO",
  "text": "BISCUIT वाला card फिर से tap करो।",
  "emotion": "clear and kind",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_063",
  "kind": "speech",
  "speaker": "ELEPHANT",
  "text": "बस दो? थोड़ा और दो, कोको!",
  "emotion": "hopeful and cheeky",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_064",
  "kind": "speech",
  "speaker": "ELEPHANT",
  "text": "कोको, मेरा पेट देखो... बहुत भूख लगी है! और खिलाओ।",
  "emotion": "playfully pleading",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_065",
  "kind": "speech",
  "speaker": "ELEPHANT",
  "text": "ओके, ओके, बस करो! और खाऊँगा तो balloon बन जाऊँगा!",
  "emotion": "playfully overwhelmed",
  "scene": 3,
  "library": false,
  "missing": false
 },
 {
