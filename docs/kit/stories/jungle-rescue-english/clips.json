 },
 {
  "id": "JR_077b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अरे पैरट जी! आपका एक पंख हिल रहा है, दूसरा आराम कर रहा है।",
  "emotion": "concerned and gentle",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_078",
  "kind": "speech",
  "speaker": "COCO",
  "text": "चिंता मत करो, पैरट जी! Captain और मैं आपकी मदद करेंगे।",
  "emotion": "warm and reassuring",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_079b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "पैरट जी को चोट लगी है — हमें पट्टी और दवाई चाहिए! Captain, cards में दवाई का डब्बा ढूँढो!",
  "emotion": "caring, clear",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_080b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "अपने cards को देखो… दवाई का डब्बा दिख रहा है?",
  "emotion": "clear and warm",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_081b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "सफ़ेद डब्बा, जिस पर लाल plus बना है — उसमें पट्टी और दवाई रहती है।",
  "emotion": "clear and warm",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_082b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "दवाई वाले डब्बे का card scan करो — लाल plus वाला।",
  "emotion": "clear and warm",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_083",
  "kind": "sfx",
  "name": "ting",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_084b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "YES! दवाई का डब्बा! पट्टी और दवाई मिल गई।",
  "emotion": "happy, clear, unhurried",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_085",
  "kind": "sfx",
  "name": "bandage_wrap",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_086b",
  "kind": "speech",
  "speaker": "COCO",
  "text": "पैरट का पंख अब ठीक है। पट्टी लग गई!",
  "emotion": "gentle relief",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_087",
  "kind": "sfx",
  "name": "feather_rustle",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_088b",
  "kind": "speech",
  "speaker": "PARROT",
  "text": "Thank you, Captain! अब मैं पंख हिला कर देखूँ?",
  "emotion": "hopeful and tentative",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_089",
  "kind": "speech",
  "speaker": "COCO",
  "text": "हाँ! धीरे-धीरे—एक, दो, flap!",
  "emotion": "encouraging, rhythmic",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_090",
  "kind": "sfx",
  "name": "wing_flap",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_091b",
  "kind": "speech",
  "speaker": "PARROT",
  "text": "फड़फड़! अब मेरा पंख चल रहा है!",
  "emotion": "delighted, bright",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_093b",
  "kind": "speech",
  "speaker": "PARROT",
  "text": "लेकिन मुझे बहुत प्यास लगी है। मुझे पानी चाहिए।",
  "emotion": "tired and thirsty, not distressed",
  "scene": 4,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_094",
  "kind": "speech",
  "speaker": "COCO",
  "text": "इतने rescue missions के बाद Captain को भी थोड़ी प्यास लगी होगी। पहले तुम जाकर थोड़ा असली पानी पियो। पानी पीकर वापस आना और WATER वाला card tap करना।",
  "emotion": "caring, clear water-break instruction",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_095",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, Coco यहीं wait कर रहा है। पानी पीकर आओ और WATER वाला card tap कर देना।",
  "emotion": "kind and unhurried reminder",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_096",
  "kind": "sfx",
  "name": "ting",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_097",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Welcome back, Captain! अब पैरट को भी थोड़ा water देते हैं।",
  "emotion": "warm welcome back",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_098",
  "kind": "sfx",
  "name": "water_pour",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_099",
  "kind": "speech",
  "speaker": "PARROT",
  "text": "ओहो! पानी मिलते ही मेरी चोंच खुश हो गई!",
  "emotion": "surprised and happy",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_100",
  "kind": "sfx",
  "name": "wings_fly_away",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_101",
  "kind": "speech",
  "speaker": "PARROT",
  "text": "मैं उड़ सकता हूँ! Bye-bye, Captain!",
  "emotion": "joyful, calling as she flies away",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_102",
  "kind": "speech",
  "speaker": "COCO",
  "text": "देखो, पैरट फुर्र से उड़ गया! Jungle Rescue Team, चलो आगे!",
  "emotion": "delighted transition",
  "scene": 5,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_104",
  "kind": "speech",
  "speaker": "NARRATOR",
  "text": "रेस्क्यू जीप घने जंगलों के बीच आकर रुकी। सूरज ढल चुका था और पेड़-पौधे अंधेरे में अजीब साए जैसे लग रहे थे।",
  "emotion": "hushed and adventurous",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_105",
  "kind": "sfx",
