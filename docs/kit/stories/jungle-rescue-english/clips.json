  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_106",
  "kind": "speech",
  "speaker": "LION",
  "text": "आ... छी! आ... छी!",
  "emotion": "two heavy but harmless childlike sneezes",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "lib:listen_carefully",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain, ध्यान से सुनो…",
  "emotion": "whispering",
  "scene": 6,
  "library": true,
  "nameText": "{name}, ध्यान से सुनो…",
  "missing": false
 },
 {
  "id": "JR_107",
  "kind": "speech",
  "speaker": "COCO",
  "text": "Captain... उस बड़ी rock के पीछे कोई छुपा है!",
  "emotion": "whispering, nervous but playful",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_108",
  "kind": "speech",
  "speaker": "LION",
  "text": "ह-हेलो? कोई है वहाँ?",
  "emotion": "small and embarrassed",
  "scene": 6,
  "library": false,
  "missing": false
 },
 {
  "id": "JR_106_lion",
